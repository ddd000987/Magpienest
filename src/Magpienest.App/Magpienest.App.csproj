<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Magpienest.App</RootNamespace>
    <OutDir>$(RepoRoot)artifacts\bin\$(Configuration)\</OutDir>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Magpienest.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpienest.Core\Magpienest.Core.csproj" />
    <ProjectReference Include="..\Magpienest.Sdk\Magpienest.Sdk.csproj" />
  </ItemGroup>

  <!-- Every built-in plugin: built into artifacts/bin/<cfg>/plugins/<id>/, never referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\plugins\Magpienest.Plugins.About\Magpienest.Plugins.About.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Localization\Magpienest.Plugins.Localization.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Shell\Magpienest.Plugins.Shell.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Settings\Magpienest.Plugins.Settings.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.DevTools\Magpienest.Plugins.DevTools.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
