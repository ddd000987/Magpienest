<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Magpienest.App</RootNamespace>
    <OutDir>$(RepoRoot)artifacts\bin\$(Configuration)\</OutDir>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Magpienest</AssemblyName>
    <ApplicationIcon>Assets\Magpienest.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Magpienest.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpienest.Core\Magpienest.Core.csproj" />
    <ProjectReference Include="..\Magpienest.Sdk\Magpienest.Sdk.csproj" />
  </ItemGroup>

  <!-- Every built-in plugin: built into artifacts/bin/<cfg>/plugins/<id>/, never referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\plugins\Magpienest.Plugins.About\Magpienest.Plugins.About.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Archives\Magpienest.Plugins.Archives.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Comic\Magpienest.Plugins.Comic.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Game\Magpienest.Plugins.Game.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Imaging\Magpienest.Plugins.Imaging.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.ImageViewer\Magpienest.Plugins.ImageViewer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.ImageWindow\Magpienest.Plugins.ImageWindow.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Illustration\Magpienest.Plugins.Illustration.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.MediaEngine.LibVlc\Magpienest.Plugins.MediaEngine.LibVlc.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Video\Magpienest.Plugins.Video.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Library\Magpienest.Plugins.Library.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Localization\Magpienest.Plugins.Localization.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Shell\Magpienest.Plugins.Shell.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Settings\Magpienest.Plugins.Settings.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.DevTools\Magpienest.Plugins.DevTools.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\plugins\Magpienest.Plugins.Thumbnails\Magpienest.Plugins.Thumbnails.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
