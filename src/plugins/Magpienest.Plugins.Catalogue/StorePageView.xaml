<UserControl x:Class="Magpienest.Plugins.Catalogue.StorePageView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{sdk:Loc Catalogue.Page.Hint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" Margin="0,0,0,12" />
    <Border Visibility="{Binding ShowRestartBar, Converter={StaticResource BoolToVisibility}}"
            Margin="0,0,0,12" Padding="16,10" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemFillColorAttentionBrush}"
            CornerRadius="{DynamicResource ControlCornerRadius}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{sdk:Loc Catalogue.Page.RestartBar}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Grid.Column="1" Command="{Binding RestartNowCommand}" Content="{sdk:Loc Catalogue.Page.RestartNow}" />
      </Grid>
    </Border>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="{sdk:Loc Catalogue.Page.Refresh}" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,8" Padding="16,12" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding DetailsText}" Style="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="ActionButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="96"
                      Command="{Binding ActCommand}" Content="{Binding ActionText}" />
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
              <Setter TargetName="ActionButton" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox IsChecked="{Binding CheckAtStartup}" Content="{sdk:Loc Catalogue.Page.CheckAtStartup}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
