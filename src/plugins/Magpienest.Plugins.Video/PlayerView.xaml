<UserControl x:Class="Magpienest.Plugins.Video.PlayerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk"
             Focusable="True" FocusVisualStyle="{x:Null}">
  <UserControl.Resources>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <!-- Root.Background is a nearly invisible hit-test brush set in code: a fully transparent pixel of the
       layered overlay window lets clicks fall through to the video surface. -->
  <Grid x:Name="Root">
    <!-- Top right: a translucent close button. -->
    <Button x:Name="CloseButton" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,12,12,0" Width="36" Height="36" Padding="0" Focusable="False" Opacity="0.7"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            ToolTip="{sdk:Loc Video.Player.Close}" AutomationProperties.Name="{sdk:Loc Video.Player.Close}">
      <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="12" />
    </Button>

    <!-- Bottom: a floating control card. -->
    <Border x:Name="BottomBar" Style="{StaticResource Card}" VerticalAlignment="Bottom" Margin="12,0,12,12"
            Padding="16,8,16,8" MaxWidth="1100">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" VerticalAlignment="Center" MinWidth="56" TextAlignment="Left"
                     Style="{DynamicResource CaptionTextBlockStyle}" />
          <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                  Focusable="False" VerticalAlignment="Center" Margin="8,0"
                  AutomationProperties.Name="{sdk:Loc Video.Player.Seek}" />
          <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right"
                     Style="{DynamicResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- The video's title, under the seek bar. -->
        <TextBlock x:Name="TitleText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Left: volume. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="MuteButton" Style="{StaticResource BarButton}" Click="Mute_Click">
              <TextBlock x:Name="MuteGlyph" Text="&#xE767;" Style="{StaticResource Glyph}" />
            </Button>
            <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="200" SmallChange="5" LargeChange="10"
                    IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False"
                    AutomationProperties.Name="{sdk:Loc Video.Player.Volume}" ToolTip="{sdk:Loc Video.Player.Volume}" />
            <!-- The volume as a number, shown briefly after it changes. -->
            <TextBlock x:Name="VolumeBadgeText" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
          </StackPanel>

          <!-- Centre: previous, play/pause, next. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PreviousButton" Style="{StaticResource BarButton}" Click="Previous_Click" ToolTip="{sdk:Loc Video.Player.Previous}">
              <TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" />
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource BarButton}" Click="Play_Click" Width="52" Height="52" Margin="8,0">
              <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="26" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource BarButton}" Click="Next_Click" ToolTip="{sdk:Loc Video.Player.Next}">
              <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" />
            </Button>
          </StackPanel>

          <!-- Right: speed, tracks, full screen. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SpeedButton" Style="{StaticResource BarButton}" Click="Speed_Click" Width="Auto" MinWidth="40"
                    Padding="8,0" ToolTip="{sdk:Loc Video.Player.Speed}">
              <TextBlock x:Name="SpeedText" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="AudioButton" Style="{StaticResource BarButton}" Click="Audio_Click" ToolTip="{sdk:Loc Video.Player.Audio}">
              <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" />
            </Button>
            <Button x:Name="SubtitleButton" Style="{StaticResource BarButton}" Click="Subtitle_Click" ToolTip="{sdk:Loc Video.Player.Subtitles}">
              <TextBlock Text="&#xED1E;" Style="{StaticResource Glyph}" />
            </Button>
            <Button x:Name="FullScreenButton" Style="{StaticResource BarButton}" Click="FullScreen_Click">
              <TextBlock x:Name="FullScreenGlyph" Text="&#xE740;" Style="{StaticResource Glyph}" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
