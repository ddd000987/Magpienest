<UserControl x:Class="Magpienest.Plugins.Video.VideoSettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <StackPanel>
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="{sdk:Loc Video.Settings.Extensions}" Style="{DynamicResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="{sdk:Loc Video.Settings.ExtensionsHint}" Style="{DynamicResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="False"
                 AutomationProperties.Name="{sdk:Loc Video.Settings.Extensions}" />
        <Button Content="{sdk:Loc Video.Settings.ResetExtensions}" Command="{Binding ResetExtensionsCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,0,0,8">
      <CheckBox Content="{sdk:Loc Video.Settings.ContinueNext}" IsChecked="{Binding ContinueWithNext}" />
    </Border>
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,0,0,8">
      <StackPanel>
        <CheckBox Content="{sdk:Loc Video.Settings.RememberPosition}" IsChecked="{Binding RememberPosition}" />
        <TextBlock Text="{sdk:Loc Video.Settings.RememberPositionHint}" Style="{DynamicResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" Margin="28,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
