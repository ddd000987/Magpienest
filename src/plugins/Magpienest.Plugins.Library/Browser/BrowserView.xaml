<UserControl x:Class="Magpienest.Plugins.Library.Browser.BrowserView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk"
             xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:local="clr-namespace:Magpienest.Plugins.Library.Browser"
             Focusable="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:StarGlyphConverter x:Key="StarGlyph" />
    <local:InverseBoolConverter x:Key="InverseBool" />

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Grid container: fixed size, selection frame, no Fluent list pill. -->
    <Style x:Key="TileContainer" TargetType="ListBoxItem">
      <Setter Property="Width" Value="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
      <Setter Property="Height" Value="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <EventSetter Event="MouseDoubleClick" Handler="Tile_DoubleClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Margin="2" Padding="6" CornerRadius="6" BorderThickness="2"
                    Background="Transparent" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="IsSelected" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:TileViewModel}">
      <Grid x:Name="TileRoot" Background="Transparent"
            Loaded="Tile_Loaded" Unloaded="Tile_Unloaded" DataContextChanged="Tile_DataContextChanged"
            MouseEnter="Tile_MouseEnter"
            ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="800"
            ToolTipService.IsEnabled="{Binding DataContext.ShowTileToolTip, RelativeSource={RelativeSource AncestorType=ListBox}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
          <Grid>
            <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="32"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
            <Image Source="{Binding Thumbnail}" RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="{Binding DataContext.ThumbnailStretch, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="4" CornerRadius="4"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.9"
                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="12"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Padding="4" CornerRadius="4"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.9"
                    ToolTip="{sdk:Loc Library.Browser.MissingToolTip}"
                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="12"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </Border>
            <ProgressBar VerticalAlignment="Bottom" Height="3" MinHeight="3" Minimum="0" Maximum="1"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                   Style="{DynamicResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMissing}" Value="True">
          <Setter TargetName="TileRoot" Property="Opacity" Value="0.45" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <DockPanel LastChildFill="False">
        <Button x:Name="FoldersButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                Click="FoldersButton_Click" ToolTip="{sdk:Loc Library.Browser.Folders}"
                Visibility="{Binding ShowFoldersButton, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" />
            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{sdk:Loc Library.Browser.ShowFolderTree}" IsCheckable="True"
                        IsChecked="{Binding IsFolderTreeVisible}"
                        Visibility="{Binding ShowFolderTreeOption, Converter={StaticResource BoolToVisibility}}" />
              <MenuItem Header="{sdk:Loc Library.Browser.AddFolder}" Command="{Binding AddFolderCommand}" />
              <MenuItem Header="{sdk:Loc Library.Browser.ManageFolders}" Command="{Binding ManageFoldersCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <Grid DockPanel.Dock="Left" Width="280" Margin="6,0" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="32,6,32,6" PreviewKeyDown="SearchBox_PreviewKeyDown"
                   ToolTip="{sdk:Loc Library.Browser.SearchToolTip}" />
          <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,0"
                     IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="SearchHint" Text="{sdk:Loc Library.Browser.SearchPlaceholder}" Margin="34,0,32,0" VerticalAlignment="Center"
                     IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <ComboBox DockPanel.Dock="Left" Width="160" Margin="4,0" VerticalAlignment="Center"
                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label"
                  ToolTip="{sdk:Loc Library.Browser.Sort}" />
        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding ToggleDescendingCommand}"
                ToolTip="{Binding DirectionToolTip}">
          <TextBlock Text="{Binding DirectionGlyph}" Style="{StaticResource Glyph}" />
        </Button>

        <Grid DockPanel.Dock="Left">
          <ToggleButton x:Name="FilterButton" Style="{StaticResource ToolToggle}" ToolTip="{sdk:Loc Library.Browser.Filter}"
                        IsHitTestVisible="{Binding IsOpen, ElementName=FilterPopup, Converter={StaticResource InverseBool}}">
            <Grid>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" />
                <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0" />
              </StackPanel>
              <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-4,0,0"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </ToggleButton>
          <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                 StaysOpen="False" AllowsTransparency="True" VerticalOffset="4"
                 IsOpen="{Binding IsChecked, ElementName=FilterButton}">
            <Border Width="300" Padding="16,12" Margin="0,0,8,8" CornerRadius="{DynamicResource OverlayCornerRadius}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <StackPanel>
                <CheckBox Content="{sdk:Loc Library.Filter.FavoritesOnly}" IsChecked="{Binding FavoritesOnly}" />
                <TextBlock Text="{sdk:Loc Library.Filter.MinRating}" Style="{StaticResource SectionLabel}" />
                <ComboBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding MinRating}" DisplayMemberPath="Label"
                          HorizontalAlignment="Stretch" />
                <StackPanel Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{sdk:Loc Library.Filter.Status}" Style="{StaticResource SectionLabel}" />
                  <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <CheckBox Content="{sdk:Loc Library.Filter.ShowMissing}" IsChecked="{Binding ShowMissing}" Margin="0,12,0,0" />
                <TextBlock Text="{sdk:Loc Library.Filter.Tags}" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{sdk:Loc Library.Filter.NoTags}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTagFilters}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasTagFilters, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding TagFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:TagFilterItem}">
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <TextBlock Text="{Binding CountText}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Content="{sdk:Loc Library.Filter.Clear}" Command="{Binding ClearFiltersCommand}"
                        HorizontalAlignment="Right" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Right side -->
        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" IsChecked="{Binding IsDetailsVisible}"
                      ToolTip="{sdk:Loc Library.Browser.Details}">
          <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" />
        </ToggleButton>
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding RescanCommand}"
                ToolTip="{sdk:Loc Library.Browser.Rescan}"
                Visibility="{Binding HasScanner, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding AddItemCommand}"
                Visibility="{Binding CanAddItem, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" />
            <TextBlock Text="{sdk:Loc Library.Browser.Add}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center"
                    ToolTip="{sdk:Loc Library.Browser.TileSize}">
          <TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Slider Width="120" Minimum="120" Maximum="360" SmallChange="10" LargeChange="40" VerticalAlignment="Center"
                  Value="{Binding TileWidth}" IsMoveToPointEnabled="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Folder tree -->
      <Border Width="{Binding FolderPaneWidth}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Visibility="{Binding ShowFolderPane, Converter={StaticResource BoolToVisibility}}">
        <Grid>
        <!-- No sideways scrolling: long names are cut with an ellipsis (the tooltip has the whole path). -->
        <TreeView x:Name="Folders" ItemsSource="{Binding FolderRoots}" Background="Transparent" BorderThickness="0" Padding="4,8"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ContextMenuOpening="Folders_ContextMenuOpening" SizeChanged="Folders_SizeChanged">
          <TreeView.ContextMenu>
            <ContextMenu x:Name="FolderMenu" />
          </TreeView.ContextMenu>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
              <!-- The view limits the width of each header to what is left of the tree's width. -->
              <Grid Loaded="FolderHeader_Loaded" Unloaded="FolderHeader_Unloaded">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NodeGlyph" Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- The folder's own labels: a star with its rating, a tag mark. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,0,2,0"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="{Binding Rating}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                  <Setter TargetName="NodeGlyph" Property="Text" Value="&#xE8A9;" />
                </DataTrigger>
              </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <!-- Drag the pane's right edge to change its width. -->
        <Thumb HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE"
               DragDelta="FolderPaneEdge_DragDelta" DragCompleted="FolderPaneEdge_DragCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
        </Grid>
      </Border>

      <!-- Grid -->
      <Grid Grid.Column="1">
        <local:TileListBox x:Name="Tiles" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                           Padding="8" ItemTemplate="{StaticResource TileTemplate}"
                           ItemContainerStyle="{StaticResource TileContainer}"
                           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page"
                           VirtualizingPanel.CacheLength="1"
                           ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           SelectionChanged="Tiles_SelectionChanged" PreviewKeyDown="Tiles_PreviewKeyDown"
                           ContextMenuOpening="Tiles_ContextMenuOpening">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <wpftk:VirtualizingWrapPanel ItemSize="{Binding CellSize}" SpacingMode="Uniform" StretchItems="False"
                                           Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ContextMenu>
            <ContextMenu x:Name="TileMenu" />
          </ListBox.ContextMenu>
        </local:TileListBox>

        <!-- Empty states -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding ShowEmptyNoSources, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="{sdk:Loc Library.Empty.NoSources}" Style="{DynamicResource SubtitleTextBlockStyle}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
          <TextBlock Text="{sdk:Loc Library.Empty.NoSourcesHint}" TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Button Content="{sdk:Loc Library.Browser.AddFolder}" Command="{Binding AddFolderCommand}"
                  Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding ShowEmptyManual, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="{sdk:Loc Library.Empty.NoItems}" Style="{DynamicResource SubtitleTextBlockStyle}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
          <Button Command="{Binding AddItemCommand}" Style="{DynamicResource AccentButtonStyle}"
                  HorizontalAlignment="Center" Margin="0,16,0,0"
                  Visibility="{Binding CanAddItem, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" />
              <TextBlock Text="{sdk:Loc Library.Browser.Add}" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding ShowEmptyNoMatch, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="{sdk:Loc Library.Empty.NoMatch}" Style="{DynamicResource SubtitleTextBlockStyle}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
          <Button Content="{sdk:Loc Library.Filter.Clear}" Command="{Binding ClearFiltersCommand}"
                  HorizontalAlignment="Center" Margin="0,16,0,0"
                  Visibility="{Binding IsQueryNarrowed, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>

      <!-- Details -->
      <Border Grid.Column="2" Width="320" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
        <local:DetailsView DataContext="{Binding Details}" />
      </Border>
    </Grid>

    <!-- Status line -->
    <Border Grid.Row="2" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <TextBlock Text="{Binding StatusText}" Style="{DynamicResource CaptionTextBlockStyle}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Border>
  </Grid>
</UserControl>
