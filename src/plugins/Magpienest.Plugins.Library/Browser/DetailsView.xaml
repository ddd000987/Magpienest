<UserControl x:Class="Magpienest.Plugins.Library.Browser.DetailsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk"
             xmlns:local="clr-namespace:Magpienest.Plugins.Library.Browser">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:StarGlyphConverter x:Key="StarGlyph" />

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style x:Key="Star" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="StarText" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Nothing selected -->
    <TextBlock Text="{sdk:Loc Library.Details.NothingSelected}" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
               Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibility}}" />

    <!-- Single selection -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Margin="16">
        <Border Height="220" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
          <Grid>
            <TextBlock Text="&#xE91B;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>

        <TextBlock Text="{sdk:Loc Library.Details.MissingWarning}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="{sdk:Loc Library.Details.Title}" Style="{StaticResource Label}" />
        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 LostKeyboardFocus="TitleBox_LostKeyboardFocus" PreviewKeyDown="TitleBox_PreviewKeyDown" />

        <TextBlock Text="{sdk:Loc Library.Details.Path}" Style="{StaticResource Label}" />
        <TextBox Text="{Binding PathText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent" Padding="0" />
        <Button HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ShowInExplorerCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="14" />
            <TextBlock Text="{sdk:Loc Library.Menu.ShowInExplorer}" Margin="8,0,0,0" />
          </StackPanel>
        </Button>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{sdk:Loc Library.Details.Size}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,2" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeText}" Margin="0,2" />
          <TextBlock Grid.Row="1" Text="{sdk:Loc Library.Details.Modified}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,2" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModifiedText}" Margin="0,2" />
          <TextBlock Grid.Row="2" Text="{sdk:Loc Library.Details.Added}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,2" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AddedText}" Margin="0,2" />
          <TextBlock Grid.Row="3" Text="{sdk:Loc Library.Details.Opened}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,2" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OpenedText}" Margin="0,2" />
        </Grid>

        <TextBlock Text="{sdk:Loc Library.Details.Rating}" Style="{StaticResource Label}" />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Star}" Command="{Binding SetRatingCommand}" ToolTip="{sdk:Loc Library.Details.RatingToolTip}">
            <Button.CommandParameter><sys:Int32>1</sys:Int32></Button.CommandParameter>
            <TextBlock Style="{StaticResource StarText}" Text="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=1}" />
          </Button>
          <Button Style="{StaticResource Star}" Command="{Binding SetRatingCommand}" ToolTip="{sdk:Loc Library.Details.RatingToolTip}">
            <Button.CommandParameter><sys:Int32>2</sys:Int32></Button.CommandParameter>
            <TextBlock Style="{StaticResource StarText}" Text="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=2}" />
          </Button>
          <Button Style="{StaticResource Star}" Command="{Binding SetRatingCommand}" ToolTip="{sdk:Loc Library.Details.RatingToolTip}">
            <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
            <TextBlock Style="{StaticResource StarText}" Text="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=3}" />
          </Button>
          <Button Style="{StaticResource Star}" Command="{Binding SetRatingCommand}" ToolTip="{sdk:Loc Library.Details.RatingToolTip}">
            <Button.CommandParameter><sys:Int32>4</sys:Int32></Button.CommandParameter>
            <TextBlock Style="{StaticResource StarText}" Text="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=4}" />
          </Button>
          <Button Style="{StaticResource Star}" Command="{Binding SetRatingCommand}" ToolTip="{sdk:Loc Library.Details.RatingToolTip}">
            <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
            <TextBlock Style="{StaticResource StarText}" Text="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=5}" />
          </Button>
        </StackPanel>

        <CheckBox Content="{sdk:Loc Library.Details.Favorite}" IsChecked="{Binding IsFavorite}" Margin="0,12,0,0" />

        <StackPanel Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{sdk:Loc Library.Filter.Status}" Style="{StaticResource Label}" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <TextBlock Text="{sdk:Loc Library.Details.Tags}" Style="{StaticResource Label}" />
        <local:TagEditorView DataContext="{Binding Tags}" />

        <TextBlock Text="{sdk:Loc Library.Details.Notes}" Style="{StaticResource Label}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="80" VerticalScrollBarVisibility="Auto" />

        <ContentControl Content="{Binding CustomDetails}" Margin="0,16,0,0" Focusable="False" />
      </StackPanel>
    </ScrollViewer>

    <!-- Multiple selection -->
    <StackPanel Margin="16" Visibility="{Binding IsMultiple, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding CountText}" Style="{DynamicResource SubtitleTextBlockStyle}" />

      <TextBlock Text="{sdk:Loc Library.Details.Favorite}" Style="{StaticResource Label}" />
      <WrapPanel>
        <Button Content="{sdk:Loc Library.Details.FavoriteAll}" Margin="0,0,8,8"
                Command="{Binding DataContext.SetFavoriteCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Boolean>True</sys:Boolean></Button.CommandParameter>
        </Button>
        <Button Content="{sdk:Loc Library.Details.UnfavoriteAll}" Margin="0,0,8,8"
                Command="{Binding DataContext.SetFavoriteCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Boolean>False</sys:Boolean></Button.CommandParameter>
        </Button>
      </WrapPanel>

      <TextBlock Text="{sdk:Loc Library.Details.Rating}" Style="{StaticResource Label}" />
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Star}" ToolTip="{sdk:Loc Library.Details.RateAll}"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>1</sys:Int32></Button.CommandParameter>
          <TextBlock Style="{StaticResource StarText}" Text="&#xE734;" />
        </Button>
        <Button Style="{StaticResource Star}" ToolTip="{sdk:Loc Library.Details.RateAll}"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>2</sys:Int32></Button.CommandParameter>
          <TextBlock Style="{StaticResource StarText}" Text="&#xE734;" />
        </Button>
        <Button Style="{StaticResource Star}" ToolTip="{sdk:Loc Library.Details.RateAll}"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
          <TextBlock Style="{StaticResource StarText}" Text="&#xE734;" />
        </Button>
        <Button Style="{StaticResource Star}" ToolTip="{sdk:Loc Library.Details.RateAll}"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>4</sys:Int32></Button.CommandParameter>
          <TextBlock Style="{StaticResource StarText}" Text="&#xE734;" />
        </Button>
        <Button Style="{StaticResource Star}" ToolTip="{sdk:Loc Library.Details.RateAll}"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
          <TextBlock Style="{StaticResource StarText}" Text="&#xE734;" />
        </Button>
        <Button Content="{sdk:Loc Library.Details.ClearRating}" Margin="8,0,0,0"
                Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}">
          <Button.CommandParameter><sys:Int32>0</sys:Int32></Button.CommandParameter>
        </Button>
      </StackPanel>

      <TextBlock Text="{sdk:Loc Library.Details.AddTagToAll}" Style="{StaticResource Label}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="BulkTagBox" IsEditable="True" IsTextSearchEnabled="True"
                  ItemsSource="{Binding Tags.Suggestions}" PreviewKeyDown="BulkTagBox_PreviewKeyDown" />
        <Button Grid.Column="1" Margin="6,0,0,0" Click="BulkTagAdd_Click" ToolTip="{sdk:Loc Library.Tags.Add}">
          <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" />
        </Button>
      </Grid>
      <Button Content="{sdk:Loc Library.Menu.EditTags}" HorizontalAlignment="Left" Margin="0,12,0,0"
              Command="{Binding DataContext.EditTagsCommand, RelativeSource={RelativeSource AncestorType=local:BrowserView}}" />
    </StackPanel>
  </Grid>
</UserControl>
