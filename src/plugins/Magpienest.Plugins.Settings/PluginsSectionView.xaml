<UserControl x:Class="Magpienest.Plugins.Settings.PluginsSectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <StackPanel>
    <TextBlock Text="{sdk:Loc Settings.Plugins.Hint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" Margin="0,0,0,12" />
    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,8" Padding="16,12" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <WrapPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding VersionText}" Style="{DynamicResource CaptionTextBlockStyle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="StateBadge" Text="{Binding StateText}" Style="{DynamicResource CaptionTextBlockStyle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </WrapPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="Author" Text="{Binding AuthorText}" Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <CheckBox Grid.Column="1" VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                        Content="{sdk:Loc Settings.Plugins.Enabled}"
                        ToolTip="{Binding ToggleToolTip}" ToolTipService.ShowOnDisabled="True" />
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Active">
              <Setter TargetName="StateBadge" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting">
              <Setter TargetName="StateBadge" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
              <Setter TargetName="StateBadge" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasAuthor}" Value="False">
              <Setter TargetName="Author" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
