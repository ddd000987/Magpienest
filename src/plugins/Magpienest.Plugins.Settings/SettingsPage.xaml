<UserControl x:Class="Magpienest.Plugins.Settings.SettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="2" Text="{sdk:Loc Settings.Nav.Title}" Style="{DynamicResource TitleTextBlockStyle}" Margin="4,0,0,16" />

    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Height="24" ToolTip="{Binding Title}">
            <Grid Width="20">
              <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16"
                         TextAlignment="Center" VerticalAlignment="Center" />
              <Ellipse x:Name="Badge" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,-3,0"
                       Fill="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasBadge}" Value="True">
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding SelectedSection.Title}" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,12" />
        <ContentControl Content="{Binding SelectedView}" Focusable="False" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
