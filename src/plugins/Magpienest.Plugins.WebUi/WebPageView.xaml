<UserControl x:Class="Magpienest.Plugins.WebUi.WebPageView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <Grid>
    <!-- The WebView2 control is added here in code once its runtime has started. -->
    <Grid x:Name="BrowserHost" Visibility="{Binding ShowBrowser, Converter={StaticResource Visible}}" />

    <StackPanel MaxWidth="480" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowMessage, Converter={StaticResource Visible}}">
      <TextBlock Text="{sdk:Loc WebUi.Page.NoRuntime}" TextWrapping="Wrap" TextAlignment="Center"
                 Visibility="{Binding NoRuntime, Converter={StaticResource Visible}}" />
      <TextBlock Text="{sdk:Loc WebUi.Page.NotRunning}" TextWrapping="Wrap" TextAlignment="Center"
                 Visibility="{Binding NotRunning, Converter={StaticResource Visible}}" />
      <Button Content="{sdk:Loc WebUi.Settings.OpenInBrowser}" Command="{Binding OpenInBrowserCommand}"
              Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0"
              Visibility="{Binding NoRuntime, Converter={StaticResource Visible}}" />
    </StackPanel>
  </Grid>
</UserControl>
