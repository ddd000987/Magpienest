<Window x:Class="Magpienest.Plugins.Shell.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk"
        xmlns:local="clr-namespace:Magpienest.Plugins.Shell"
        Title="Magpienest"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="GlyphText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NavList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type local:NavItem}">
      <StackPanel Orientation="Horizontal" Height="24" Background="Transparent" ToolTip="{Binding Title}">
        <Grid Width="20">
          <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphText}" />
          <Ellipse x:Name="Badge" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,-3,0"
                   Fill="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
        </Grid>
        <TextBlock x:Name="TitleText" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasBadge}" Value="True">
          <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.IsRailCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type local:ToastItem}">
      <Border Margin="0,8,0,0" Padding="0,0,4,0"
              CornerRadius="{DynamicResource OverlayCornerRadius}"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="Bar" Width="4" Margin="8" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="4,12" VerticalAlignment="Center" />
          <Button Grid.Column="2" Command="{Binding CloseCommand}" ToolTip="{sdk:Loc Shell.Toast.Close}"
                  VerticalAlignment="Top" Margin="0,4,0,0" Padding="6" Background="Transparent" BorderThickness="0">
            <TextBlock Text="&#xE711;" Style="{StaticResource GlyphText}" FontSize="12" />
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Success">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <Border Grid.Row="0" Grid.Column="0"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="220" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsRailCollapsed}" Value="True">
              <Setter Property="Width" Value="48" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel Margin="4,8">
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Width="40" Height="36" Padding="0" Margin="0,0,0,8"
                Background="Transparent" BorderThickness="0"
                Command="{Binding ToggleRailCommand}" ToolTip="{sdk:Loc Shell.Nav.Toggle}">
          <TextBlock Text="&#xE700;" Style="{StaticResource GlyphText}" />
        </Button>
        <ListBox DockPanel.Dock="Bottom" Style="{StaticResource NavList}"
                 ItemsSource="{Binding FooterItems}" SelectedItem="{Binding SelectedFooter}"
                 ItemTemplate="{StaticResource NavItemTemplate}" />
        <ListBox Style="{StaticResource NavList}"
                 ItemsSource="{Binding MainItems}" SelectedItem="{Binding SelectedMain}"
                 ItemTemplate="{StaticResource NavItemTemplate}" />
      </DockPanel>
    </Border>

    <!-- Page host -->
    <Grid Grid.Row="0" Grid.Column="1">
      <ContentControl Content="{Binding PageContent}" Focusable="False" />
      <TextBlock Text="{sdk:Loc Shell.Empty.NoPages}" Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Style="{DynamicResource SubtitleTextBlockStyle}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <!-- Status bar: background tasks -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,6"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
            Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding CurrentTask.Title}" VerticalAlignment="Center" />
        <ProgressBar Width="160" Height="4" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                     Value="{Binding CurrentTask.Progress, Mode=OneWay}"
                     IsIndeterminate="{Binding CurrentTask.IsIndeterminate, Mode=OneWay}" />
        <TextBlock Text="{Binding CurrentTask.Status}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding MoreText}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Overlays (viewer, player) -->
    <Grid x:Name="OverlayHost" Grid.RowSpan="2" Grid.ColumnSpan="2" />

    <!-- Toasts, above overlays -->
    <ItemsControl Grid.RowSpan="2" Grid.ColumnSpan="2" Width="360" Margin="16"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" />
  </Grid>
</Window>
