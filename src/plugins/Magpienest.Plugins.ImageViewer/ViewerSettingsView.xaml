<UserControl x:Class="Magpienest.Plugins.ImageViewer.ViewerSettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{sdk:Loc Viewer.Settings.Budget}" />
          <TextBlock Text="{sdk:Loc Viewer.Settings.BudgetHint}" Style="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                  ItemsSource="{Binding Budgets}" SelectedItem="{Binding Budget}" DisplayMemberPath="Label"
                  ToolTip="{sdk:Loc Viewer.Settings.Budget}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}">
      <CheckBox Content="{sdk:Loc Viewer.Settings.StretchSmall}" IsChecked="{Binding StretchSmall}" />
    </Border>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{sdk:Loc Viewer.Settings.GalleryFlow}" />
          <TextBlock Text="{sdk:Loc Viewer.Settings.FlowHint}" Style="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                  ItemsSource="{Binding GalleryFlows}" SelectedItem="{Binding GalleryFlow}" DisplayMemberPath="Label"
                  ToolTip="{sdk:Loc Viewer.Settings.GalleryFlow}" />
      </Grid>
    </Border>
    <TextBlock Text="{sdk:Loc Viewer.Settings.BookHeader}" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,12,0,8" />
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{sdk:Loc Viewer.Settings.Direction}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                  ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" DisplayMemberPath="Label"
                  ToolTip="{sdk:Loc Viewer.Settings.Direction}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{sdk:Loc Viewer.Settings.Spread}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                  ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" DisplayMemberPath="Label"
                  ToolTip="{sdk:Loc Viewer.Settings.Spread}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox Content="{sdk:Loc Viewer.Settings.CoverAlone}" IsChecked="{Binding CoverAlone}" />
        <TextBlock Text="{sdk:Loc Viewer.Settings.CoverAloneHint}" Style="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Margin="28,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
