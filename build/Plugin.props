<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Built-in plugins sit next to the host; external ones (ExternalPlugin=true) are packed as their own zip
         and are loaded only after the user installs them. -->
    <OutDir Condition="'$(ExternalPlugin)' != 'true'">$(RepoRoot)artifacts\bin\$(Configuration)\plugins\$(PluginId)\</OutDir>
    <OutDir Condition="'$(ExternalPlugin)' == 'true'">$(RepoRoot)artifacts\bin\$(Configuration)\external\$(PluginId)\</OutDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Magpienest.Sdk\Magpienest.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Compile-time only (source generators); the host supplies the runtime copy through the SDK. -->
    <PackageReference Include="CommunityToolkit.Mvvm" ExcludeAssets="runtime" />
    <!-- CopyToPublishDirectory=Never: the publish script copies plugins itself; the host publish must not pull them in. -->
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
