<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <Version>0.1.1</Version>
    <Authors>Magpienest contributors</Authors>
    <Copyright>Copyright (c) 2026 Magpienest contributors</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF0001: Application.ThemeMode is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- libraries; App and plugins override OutDir -->
    <BaseOutputPath>$(RepoRoot)artifacts\lib\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
