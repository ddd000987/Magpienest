<UserControl x:Class="HelloPlugin.HelloView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:Magpienest.Sdk.Localization;assembly=Magpienest.Sdk">
  <Grid Margin="16">
    <Border Padding="24" VerticalAlignment="Top" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            CornerRadius="{DynamicResource ControlCornerRadius}">
      <StackPanel>
        <TextBlock Text="{sdk:Loc Hello.Greeting}" Style="{DynamicResource TitleTextBlockStyle}" />
        <TextBlock Text="{sdk:Loc Hello.Hint}" TextWrapping="Wrap" Margin="0,8,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Button x:Name="SayHello" Content="{sdk:Loc Hello.Button}" ToolTip="{sdk:Loc Hello.Button}"
                Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" Click="OnSayHello" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
