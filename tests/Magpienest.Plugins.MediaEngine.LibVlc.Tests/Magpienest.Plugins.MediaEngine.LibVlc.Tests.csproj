    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <OutDir>$(RepoRoot)artifacts\tests\$(MSBuildProjectName)\</OutDir>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\plugins\Magpienest.Plugins.MediaEngine.LibVlc\Magpienest.Plugins.MediaEngine.LibVlc.csproj" />
    <ProjectReference Include="..\..\src\Magpienest.Sdk\Magpienest.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
